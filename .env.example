# ─────────────────────────────────────────────────────────────
# GWD Global website — environment configuration
# Copy to .env.local for development. Never commit real values.
# ─────────────────────────────────────────────────────────────

# Public canonical origin (used for metadata, sitemap, CSRF origin checks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL connection string.
# Local dev: `npm run db:dev` starts an embedded Postgres (PGlite) on 5433.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/postgres

# Connections per server process. The embedded dev database is single-session,
# so keep this at 1 locally; use ~10 against a real Postgres server.
DATABASE_POOL_MAX=1

# Where page content is read from: "database" or "snapshot".
# "snapshot" serves the bundled, version-controlled content (no DB needed).
CONTENT_SOURCE=database

# First administrator, created by `npm run db:seed` if no users exist.
# Use a long unique password; it is hashed with scrypt before storage.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Salt for hashing visitor IPs stored with enquiries (privacy). 32+ random chars.
IP_HASH_SALT=

# Set to "true" only when running behind a trusted reverse proxy / CDN
# so X-Forwarded-For is honoured for rate limiting.
TRUST_PROXY=false

# debug | info | warn | error
LOG_LEVEL=info

# Uploaded media storage (local driver). Keep outside /public.
MEDIA_STORAGE_DIR=.data/uploads
MAX_UPLOAD_MB=8
