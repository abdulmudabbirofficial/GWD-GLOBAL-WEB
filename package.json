{
  "name": "gwd-global-website",
  "version": "1.0.0",
  "private": true,
  "description": "Official website and content platform for GWD Global Pvt. Ltd. — Get Work Done.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:cluster": "node scripts/serve-cluster.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "db:dev": "pglite-server --db=.data/pglite --port=5433 --max-connections=12",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "tech:icons": "tsx scripts/build-tech-icons.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "gsap": "^3.15.0",
    "lenis": "1.3.26",
    "next": "16.3.6",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "three": "^0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@types/node": "^22.15.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "devicon": "^2.17.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.6",
    "puppeteer-core": "^25.12.0",
    "simple-icons": "^16.32.0",
    "three-gpu-pathtracer": "^0.0.26",
    "three-mesh-bvh": "^0.9.15",
    "topojson-client": "^3.1.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "world-atlas": "^2.0.2"
  }
}
